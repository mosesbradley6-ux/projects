# Copy this file to terraform.tfvars and fill in your own values.
# Do NOT commit terraform.tfvars (it will contain secrets) - it's already in .gitignore.

aws_region   = "us-east-1"
project_name = "sample3tier"
environment  = "test"

# --- Sandbox / SCP workaround values ---
# Some sandbox/training AWS accounts attach a Service Control Policy that
# explicitly denies ec2:DescribeAvailabilityZones and ssm:GetParameter.
# If you hit AccessDeniedException / "explicit deny in a service control
# policy" errors on those calls, these two variables let the config skip
# them entirely. If your account isn't restricted, the defaults below are
# fine to leave as-is (or delete these lines to fall back to the defaults
# in variables.tf).
availability_zones    = ["us-east-1a", "us-east-1b", "us-east-1c"]
amazon_linux_2_ami_id = "ami-xxxxxxxxxxxxxxxxx" # replace with a current AMI ID for your region - see variables.tf for how to look one up

key_name         = ""              # existing EC2 key pair name, or leave blank
ssh_allowed_cidr = "0.0.0.0/0"     # restrict this to your IP in real use, e.g. "203.0.113.5/32"

db_name     = "appdb"
db_username = "dbadmin"
# Do not hardcode a real password here - set it via:
#   export TF_VAR_db_password="your-strong-password"
# or pass -var="db_password=..." on the command line.
db_password = "changeme-please-override"
